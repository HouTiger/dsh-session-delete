{
  "name": "@local/dsh-session-delete",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Permanently delete sessions from the DeepSeek Harness Web sidebar (DSH 0.2.1-rc.3).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HouTiger/dsh-session-delete.git"
  },
  "homepage": "https://github.com/HouTiger/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/HouTiger/dsh-session-delete/issues"
  },
  "scripts": {
    "test": "node --test test/session-delete.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete"
  ],
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
